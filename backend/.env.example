# ---------------------------------------------------------------------------
# Postgres connection for the DIP web-app persistence layer.
# The async SQLAlchemy URL is assembled from these fields automatically.
# Copy to backend/.env and edit. Schema must match backend/schema.sql.
# ---------------------------------------------------------------------------
DIP_DB_HOST=localhost
DIP_DB_PORT=5432
DIP_DB_USER=postgres
DIP_DB_PASSWORD=postgres
DIP_DB_NAME=postgres

# Schema the tables live in (must match the one created from schema.sql).
DIP_DB_SCHEMA=gigapark_bess_designer

# Optional: full URL override (URL-encode special chars yourself if you use this).
# DIP_DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname

# ---------------------------------------------------------------------------
# Generation API — wind (/yield) and solar (/solar-profile) on one deployable.
# Base URL differs local vs deployed — point this at the running service.
# ---------------------------------------------------------------------------
DIP_GEN_API_BASE=http://127.0.0.1:8001
DIP_GEN_WIND_PATH=/yield
DIP_GEN_SOLAR_PATH=/solar-profile
DIP_GEN_API_TIMEOUT=120
DIP_GEN_ENABLED=true
DIP_GEN_SOLAR_OPTIONAL=true
